# Every build tree (presets use build/<preset>), coverage, docs and benchmark output.
/build/
/out/
# Crash artifacts of local runs.
core
core.[0-9]*
tsfs-crash-*.txt
# Editors and tools.
.vscode/
.idea/
.cache/
compile_commands.json
*.swp
*~
