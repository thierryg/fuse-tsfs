# =============================================================================
# "for (auto _ : state)" is the Google Benchmark loop idiom: the iteration value is
# intentionally unused, which the dead-store analysis reports on every benchmark.
InheritParentConfig: true
Checks: '-clang-analyzer-deadcode.DeadStores'
